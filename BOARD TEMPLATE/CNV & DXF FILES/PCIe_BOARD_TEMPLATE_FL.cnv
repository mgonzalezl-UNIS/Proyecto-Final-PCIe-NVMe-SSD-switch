#This is the Layer Conversion File used for
#importing DXF data into Allegro/APD.

#CLASS!            SUBCLASS!                           DXF_LAYER!

BOARD GEOMETRY!
                   DESIGN_OUTLINE!                     BG_DESIGN_OUTLINE!
                   SILKSCREEN_TOP!                     BG_SILKSCREEN_TOP!
                   DIMENSION!                          BG_DIMENSION!
                   TOOLING_CORNERS!                    BG_TOOLING_CORNERS!
                   OUTLINE!                            BG_OUTLINE!

PACKAGE GEOMETRY!
                   COPY RIGHT!                         PG_COPY_RIGHT!
                   DIMENSION!                          PG_DIMENSION!

PACKAGE KEEPIN!
                   ALL!                                PKI_ALL!

PACKAGE KEEPOUT!
                   ALL!                                PKO_ALL!

ROUTE KEEPIN!
                   ALL!                                RKI_ALL!

ROUTE KEEPOUT!
                   TOP!                                RKO_TOP!
                   ALL!                                RKO_ALL!

CONSTRAINT REGION!
                   TOP!                                CR_TOP!
                   GND02!                              CR_GND02!
                   ART03!                              CR_ART03!
                   ART04!                              CR_ART04!
                   PWR05!                              CR_PWR05!
                   BOTTOM!                             CR_BOTTOM!
                   INNER_PLANE_LAYERS!                 CR_INNER_PLANE_LAYERS!
                   INNER_SIGNAL_LAYERS!                CR_INNER_SIGNAL_LAYERS!
                   OUTER_LAYERS!                       CR_OUTER_LAYERS!
                   ALL!                                CR_ALL!

#END